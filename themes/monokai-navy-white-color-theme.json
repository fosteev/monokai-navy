  "tokenColors": [
    {
      "settings": {
        "foreground": "#1b2733"
      }
    },
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "string meta.image.inline.markdown",
        "variable.legacy.builtin.python"
      ],
      "settings": {
        "foreground": "#1b2733"
      }
    },
    {
      "name": "Template Definition",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#d81b60"
      }
    },
    {
      "name": "Reset JavaScript string interpolation expression",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#1b2733"
      }
    },
    {
      "name": "User-defined constant",
      "scope": [
        "constant.character"
      ],
      "settings": {
        "foreground": "#6f42c1"
      }
    },
    {
      "name": "Class name",
      "scope": [
        "entity.name.namespace",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#4f8a10"
      }
    },
    {
      "name": "Inherited class",
      "scope": [
        "punctuation.separator.namespace.ruby"
      ],
      "settings": {
        "fontStyle": "italic underline",
        "foreground": "#4f8a10"
      }
    },
    {
      "name": "Library variable",
      "scope": [
        "support.other.variable"
      ],
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#c62828"
      }
    },
    {
      "name": "JSON String",
      "scope": [
        "meta.structure.dictionary.json string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#1b2733"
      }
    },
    {
      "name": "diff.header",
      "scope": [
        "meta.diff",
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#7a8590"
      }
    },
    {
      "name": "diff.deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#d81b60"
      }
    },
    {
      "name": "diff.inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#4f8a10"
      }
    },
    {
      "name": "diff.changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#9a7d0a"
      }
    },
    {
      "scope": [
        "constant.numeric.line-number.find-in-files - match"
      ],
      "settings": {
        "foreground": "#6f42c1a0"
      }
    },
    {
      "scope": [
        "entity.name.filename.find-in-files"
      ],
      "settings": {
        "foreground": "#9a7d0a"
      }
    },
    {
      "name": "Markup Quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#d81b60"
      }
    },
    {
      "name": "Markup Lists",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#9a7d0a"
      }
    },
    {
      "name": "Markup Styling",
      "scope": [
        "markup.bold",
        "markup.italic"
      ],
      "settings": {
        "foreground": "#0b7fa5"
      }
    },
    {
      "name": "Markup Inline",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#c25e00"
      }
    },
    {
      "name": "Markup Headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#4f8a10"
      }
    },
    {
      "name": "Markup Setext Header",
      "scope": [
        "markup.heading.setext"
      ],
      "settings": {
        "foreground": "#4f8a10",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Headings",
      "scope": [
        "markup.heading.markdown"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": [
        "markup.quote.markdown"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#7a8590"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold.markdown"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Link Title/Description",
      "scope": [
        "string.other.link.title.markdown",
        "string.other.link.description.markdown"
      ],
      "settings": {
        "foreground": "#6f42c1"
      }
    },
    {
      "name": "Markdown Underline Link/Image",
      "scope": [
        "markup.underline.link.markdown",
        "markup.underline.link.image.markdown"
      ],
      "settings": {
        "foreground": "#9a7d0a"
      }
    },
    {
      "name": "Markdown Emphasis",
      "scope": [
        "markup.italic.markdown"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown Punctuation Definition Link",
      "scope": [
        "markup.list.unnumbered.markdown",
        "markup.list.numbered.markdown"
      ],
      "settings": {
        "foreground": "#1b2733"
      }
    },
    {
      "name": "Markdown List Punctuation",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#4f8a10"
      }
    },
    {
      "scope": [
        "token.info-token"
      ],
      "settings": {
        "foreground": "#1565c0"
      }
    },
    {
      "scope": [
        "token.warn-token"
      ],
      "settings": {
        "foreground": "#c25e00"
      }
    },
    {
      "scope": [
        "token.error-token"
      ],
      "settings": {
        "foreground": "#c62828"
      }
    },
    {
      "scope": [
        "token.debug-token"
      ],
      "settings": {
        "foreground": "#6f42c1"
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7a8590"
      }
    },
    {
      "name": "Doc comment",
      "scope": [
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#7a8590"
      }
    },
    {
      "name": "Doc tag",
      "scope": [
        "keyword.other.phpdoc",
        "storage.type.class.jsdoc",
        "punctuation.definition.block.tag.jsdoc"
      ],
      "settings": {
        "foreground": "#7a8590"
      }
    },
    {
      "name": "Doc tag value",
      "scope": [
        "comment.block.documentation variable",
        "comment.block.documentation entity.name.type"
      ],
      "settings": {
        "foreground": "#d81b60"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#d81b60"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#d81b60"
      }
    },
    {
      "name": "Comma",
      "scope": [
        "punctuation.separator.delimiter",
        "punctuation.separator.comma"
      ],
      "settings": {
        "foreground": "#d81b60"
      }
    },
    {
      "name": "Dot / arrow",
      "scope": [
        "keyword.operator.class",
        "keyword.operator.accessor",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#d81b60"
      }
    },
    {
      "name": "Semicolon",
      "scope": [
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#d81b60"
      }
    },
    {
      "name": "Braces",
      "scope": [
        "punctuation.section.scope",
        "punctuation.definition.block",
        "meta.brace.curly",
        "punctuation.section.block"
      ],
      "settings": {
        "foreground": "#1b2733"
      }
    },
    {
      "name": "Brackets",
      "scope": [
        "punctuation.section.array",
        "meta.brace.square",
        "punctuation.definition.array"
      ],
      "settings": {
        "foreground": "#1b2733"
      }
    },
    {
      "name": "Parens",
      "scope": [
        "punctuation.definition.parameters",
        "punctuation.definition.arguments",
        "meta.brace.round",
        "punctuation.definition.begin.bracket.round",
        "punctuation.definition.end.bracket.round"
      ],
      "settings": {
        "foreground": "#1b2733"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#9a7d0a"
      }
    },
    {
      "name": "String escape",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#6f42c1"
      }
    },
    {
      "name": "Bad escape",
      "scope": [
        "invalid.illegal.character.escape"
      ],
      "settings": {
        "foreground": "#c62828"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#6f42c1"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#6f42c1"
      }
